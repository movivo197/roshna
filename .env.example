# Documentation only. Run deploy/install.sh to create .env.local and admin secrets.
# Never copy real secrets into this file or source control.
ROSHAN_APP_ORIGIN=https://roshna.moeid.net
ROSHAN_TRUST_PROXY=1
PORT=3200
# Optional absolute data directory. Defaults to the project's data/ directory.
# ROSHAN_DATA_DIR=/secure/path/roshana-data
# Commercial cryptocurrency data requires an appropriate provider license.
# ROSHAN_COINGECKO_PLAN=pro
# ROSHAN_COINGECKO_API_KEY=
# ROSHAN_COINGECKO_COMMERCIAL_LICENSE=1
# ROSHAN_IRAN_MARKET_LICENSED=1
