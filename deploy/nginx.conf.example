# aaPanel: add these directives INSIDE the server block of the NEW subdomain.
# Keep aaPanel-generated listen, server_name, TLS certificate and ACME blocks.
# Example: roshna.moeid.net. This app owns / on its own subdomain.
# Remove an existing conflicting `location /` only in that new site's config.
# Do not change the main website configuration.

client_max_body_size 2m;

# Private application files must never be served as static files by aaPanel.
location ^~ /.git/ { return 404; }
location ^~ /.next/ { return 404; }
location ^~ /data/ { return 404; }
location ^~ /scripts/ { return 404; }
location ^~ /deploy/ { return 404; }
location = /.env.local { return 404; }

location = /sw.js {
    proxy_pass http://127.0.0.1:3200;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    add_header Service-Worker-Allowed "/" always;
    proxy_hide_header Cache-Control;
}

location = /offline-manifest.json {
    proxy_pass http://127.0.0.1:3200;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    add_header Cache-Control "no-store" always;
    proxy_hide_header Cache-Control;
}

# This ^~ prevents aaPanel regex rules for js/css/images from bypassing Node.
location ^~ /_next/static/ {
    proxy_pass http://127.0.0.1:3200;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
}

location ^~ /icons/ {
    proxy_pass http://127.0.0.1:3200;
    proxy_set_header Host $host;
}

location ^~ /fonts/ {
    proxy_pass http://127.0.0.1:3200;
    proxy_set_header Host $host;
}

location / {
    proxy_pass http://127.0.0.1:3200;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Trust exactly the connecting peer. If using a CDN, configure Nginx's
    # real_ip module with that CDN's verified ranges before trusting its header.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_read_timeout 60s;
    proxy_buffering off;
    proxy_cache off;
}
